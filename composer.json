{
    "name": "rostamlabs/rostam-client-php",
    "description": "A PHP client for Rostam - speaks the native binary TCP protocol of its key-value engine, with connection pooling, pipelining, TLS and token auth. No framework, no extensions beyond core streams.",
    "keywords": [
        "rostam",
        "key-value",
        "client",
        "vector-database",
        "tcp"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Keivan Sohrabloo",
            "email": "K.sohrabloo.k@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rostam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rostam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
